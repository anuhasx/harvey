# Always-on Harvey dashboard (Italy), local only. nginx publishes it with a
# password (deploy/nginx/); never bind it to 0.0.0.0 — it has no login of its own.
[Unit]
Description=Harvey dashboard (Italy)
After=network-online.target
Wants=network-online.target

[Service]
User=harvey
Group=harvey
WorkingDirectory=/www/wwwroot/harvey-italy
Environment=PATH=/www/wwwroot/harvey-italy/.venv/bin:/home/harvey/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/www/wwwroot/harvey-italy/.venv/bin/harvey dashboard --host 127.0.0.1 --port 5556
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
